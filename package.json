{
  "name": "pi-prewalk",
  "version": "0.1.0",
  "description": "Todo-gated Pi policy with trajectory-preserving model transitions",
  "author": "Christiano Higuto",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chrishiguto/dotfiles.git",
    "directory": "pi/packages/prewalk"
  },
  "keywords": ["pi-package", "pi-extension", "model-routing", "prewalk"],
  "files": [
    "extensions",
    "src",
    "README.md"
  ],
  "pi": {
    "extensions": [
      "./extensions/prewalk/index.ts"
    ]
  },
  "scripts": {
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:policy": "node --import tsx --test test/policy.test.ts test/prewalk-workflow.test.ts",
    "test:transitions": "node --import tsx --test test/integration/prewalk-extension.test.ts test/prewalk-command.test.ts test/prewalk-context.test.ts test/target-resolution.test.ts",
    "test:router": "node --import tsx --test test/trajectory-router.test.ts",
    "test:compatibility": "node --import tsx --test test/pi-compatibility.test.ts",
    "test:shape": "node --import tsx --test test/package-shape.test.ts",
    "typecheck": "tsc --noEmit",
    "package:check": "pnpm pack --dry-run --json",
    "check": "pnpm run typecheck && pnpm test && pnpm run package:check"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "^0.84.2"
  },
  "engines": {
    "node": ">=24"
  }
}
